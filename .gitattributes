# Normalize line endings for cross-platform consistency
* text=auto

# Source files — always LF
*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsonl text eol=lf
*.ini   text eol=lf
*.mako  text eol=lf

# Config files — always LF
*.config text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.dockerignore text eol=lf
.git-blame-ignore-revs text eol=lf
.gitkeep text eol=lf
.last_ingest_sha text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf

# Portable git-native hooks — extensionless shell scripts (git's hooksPath
# contract requires the exact names `pre-commit`/`pre-merge-commit`/`pre-push`,
# no `.sh`), so the `*.sh` rule above doesn't catch them. A CRLF-mangled
# shebang line breaks `exec` on POSIX (Linux CI, macOS) and Git for Windows'
# bundled sh alike, so pin LF the same as `*.sh`.
.githooks/pre-commit text eol=lf
.githooks/pre-merge-commit text eol=lf
.githooks/pre-push text eol=lf

# Why `*.mjs` is pinned separately from `*.js` (2026-08-12): without it, `.mjs`
# fell through to `* text=auto` and checked out CRLF on a Windows clone
# (`core.autocrlf=true`). The Workflow harness inlines the file named by
# `scriptPath` and its permission validator rejects any `\r` as a control
# character, so `.claude/workflows/n1-baseline.mjs` could not be invoked at all
# — Epic B run 1 was blocked at invocation until this line existed. Observed by
# a two-arm probe: identical dummy scripts, CRLF rejected / LF ran clean.
#
# Coverage of this file is a GATE, not a convention (charter C-11 — the `.mjs`
# hole was the third instance of the class): tests/test_gitattributes_coverage.py
# asks `git check-attr` for every tracked file and fails on any whose text/eol
# resolution would fall to `core.autocrlf`. Adding a new file type? That test
# names the file until a rule here decides it.

# Binary — never diff or mangle
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
